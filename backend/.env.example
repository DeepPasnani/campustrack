# ============================================================
# CampusTrack Backend Environment Variables
# Copy this file to .env and fill in all values
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Number of reverse-proxy hops in front of this server (Nginx, load balancer,
# CDN, etc). Needed so req.ip sees the real client IP instead of the
# proxy's IP. 1 matches the bundled docker-compose Nginx setup; increase
# to 2 if you also put a platform LB/CDN in front of that.
TRUST_PROXY=1

# ── PostgreSQL Database ───────────────────────────────────────
# Option A: Full connection string (Supabase, Railway, Neon, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campustrack?sslmode=require

# Option B: Individual fields (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campustrack
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── Redis ─────────────────────────────────────────────────────
# Upstash Redis (free tier works for 1000 students)
# Get from: https://console.upstash.com
REDIS_URL=redis://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379
# OR for local Redis:
# REDIS_URL=redis://localhost:6379

# ── JWT Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX_STRING

# ── Google OAuth ──────────────────────────────────────────────
# Steps:
# 1. Go to https://console.cloud.google.com
# 2. Create a new project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized JavaScript origins: http://localhost:5173 AND your production domain
# 5. Add Authorized redirect URIs: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── AI Features ──────────────────────────────────────────────
# Powers AI question generation, coding hints, auto-tagging, performance
# feedback, and NL analytics. Uses any OpenAI-compatible chat-completions
# endpoint (OpenAI, Azure OpenAI, Groq, Together, local Ollama, etc.).
# OPENAI_API_KEY is required for the AI features to work.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
# OPENAI-compatible provider/model. Defaults to openai / gpt-4o-mini.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# ── Image Uploads ──────────────────────────────────────────────
# Question/option images are stored as bytea rows directly in Postgres
# (see the `images` table created by src/db/migrate.js) and served back at
# GET /api/images/:id. No third-party file host or extra config needed —
# just a working DATABASE_URL above.

# ── Piston (Code Execution) ──────────────────────────────────
# Piston is now the ONLY code execution provider. See infra/piston/
# for the docker-compose services and one-time package install step.
PISTON_API_URL=http://piston-lb:2000/api/v2
CODE_EXECUTION_PROVIDER=piston

# ── Email (Optional: for notifications) ──────────────────────
# Use Gmail App Password or SendGrid
# Gmail: https://myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_college_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=CampusTrack <noreply@yourcollege.edu>

# ── SSO / SAML / LDAP ─────────────────────────────────────────
SSO_PROVIDER=saml|ldap|google
SAML_ENTRY_POINT=https://your-idp.com/saml/SSO
SAML_ISSUER=https://your-app.com
SAML_CERT=-----BEGIN CERTIFICATE-----\nYOUR_CERT\n-----END CERTIFICATE-----
LDAP_URL=ldap://your-ldap-server:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_DOMAIN=institution.edu

# ── LMS Integration ───────────────────────────────────────────
LMS_TYPE=moodle|canvas|blackboard
LMS_BASE_URL=https://your-lms-instance.com
LMS_API_KEY=your_lms_api_key
LMS_API_SECRET=your_lms_api_secret

# ── ATS Integration ───────────────────────────────────────────
ATS_TYPE=greenhouse|lever|generic
ATS_API_KEY=your_ats_api_key
ATS_API_SECRET=your_ats_api_secret
ATS_COMPANY_ID=your_company_id

# ── Zoom API ──────────────────────────────────────────────────
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret

# ── Stripe Payments ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Razorpay Payments ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Twilio SMS ────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Outlook Calendar ──────────────────────────────────────────
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
