# ============================================================
# CampusTrack — root environment file, read by docker-compose.yml.
# Copy to `.env` in this same directory and fill in the values below.
# `docker compose up` will refuse to start until the REQUIRED ones
# (marked below) are set — that's intentional, this runs real student
# data on a public domain.
# ============================================================

# ── Domain / networking (REQUIRED) ─────────────────────────────
# The public domain this deploys on. Caddy requests a real Let's Encrypt
# certificate for this automatically — DNS must already point at this
# host and ports 80/443 must be reachable from the internet.
DOMAIN=campustrack.deadpan.qzz.io

# Plain-HTTP debug port (no domain/TLS needed) for direct host access
# while testing, e.g. via `curl http://localhost:2828` or a Cloudflare
# Tunnel pointed at this port instead of 80/443.
DEBUG_PORT=2828

# ── Database (REQUIRED) ─────────────────────────────────────────
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# ── Auth secrets (REQUIRED) ──────────────────────────────────────
# Generate each with: openssl rand -base64 48
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# ── Piston (code execution) tuning ───────────────────────────────
# Max concurrent code-execution jobs the single Piston instance will run
# before queuing extra requests. Tuned for 16GB RAM — raise if load
# testing shows headroom, lower if you see OOM kills under exam load.
PISTON_MAX_CONCURRENT_JOBS=24

# ── Branding ──────────────────────────────────────────────────────
APP_NAME=CampusTrack
COLLEGE_NAME=Your College Name

# ── Email (optional — leave blank to disable OTP/notification emails) ──
# Gmail: create an App Password at https://myaccount.google.com →
# Security → App Passwords (requires 2-Step Verification enabled). Any
# other SMTP provider (SendGrid, Mailgun, your college's mail server)
# works the same way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CampusTrack <noreply@campustrack.local>

# ── Google sign-in (optional) ────────────────────────────────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com
# (APIs & Services → Credentials → "Web application"). Add
# https://<DOMAIN> to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI features (optional) ───────────────────────────────────────
# Powers AI question generation, coding hints, auto-tagging, feedback,
# and NL analytics. Any OpenAI-compatible chat-completions endpoint
# works (OpenAI, Azure OpenAI, Groq, Together, local Ollama, etc).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# ── SSO / SAML / LDAP (optional) ─────────────────────────────────
SSO_PROVIDER=
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CERT=
LDAP_URL=
LDAP_BASE_DN=
LDAP_DOMAIN=

# ── LMS integration (optional) ───────────────────────────────────
LMS_TYPE=
LMS_BASE_URL=
LMS_API_KEY=
LMS_API_SECRET=

# ── ATS integration (optional) ───────────────────────────────────
ATS_TYPE=
ATS_API_KEY=
ATS_API_SECRET=
ATS_COMPANY_ID=

# ── Zoom (optional) ───────────────────────────────────────────────
ZOOM_API_KEY=
ZOOM_API_SECRET=

# ── Payments (optional) ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Twilio SMS (optional) ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Outlook Calendar (optional) ───────────────────────────────────
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# ── Observability (REQUIRED for the grafana/prometheus/loki stack) ──
# Grafana login — dashboards live at http://localhost:3001 by default
# (loopback-only; see the grafana service's `ports:` comment in
# docker-compose.yml for how to publish it on a subdomain instead).
# Generate the password with: openssl rand -base64 18
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Sentry error tracking (optional — leave blank to disable) ────
# Create a project at https://sentry.io for each (Node.js/Express for the
# backend, React for the frontend) and paste each project's DSN from
# Settings → Client Keys (DSN). Everything works normally with these
# blank; Sentry.init() is skipped entirely and nothing is sent anywhere.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
VITE_SENTRY_DSN=
